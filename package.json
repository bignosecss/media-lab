{
  "name": "medialab-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A framework-agnostic media player: a framework-free core plus React and Vue 3 adapters with independently usable controller components.",
  "license": "MIT",
  "keywords": [
    "media",
    "player",
    "video",
    "audio",
    "react",
    "vue",
    "components",
    "accessible",
    "frameworks-agnostic"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev:docs": "pnpm --filter docs dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "clean": "rimraf '**/{dist,*.tsbuildinfo}'"
  },
  "devDependencies": {
    "oxlint": "^1.12.0",
    "typescript": "^5.8.3"
  }
}
