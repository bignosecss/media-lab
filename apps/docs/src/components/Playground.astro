---
import ReactPlayer from '../components/ReactPlayer.tsx';
import VuePlayer from '../components/VuePlayer.vue';
---

<!-- `not-content` opts the players out of Starlight's markdown spacing so their
     internal controls stay on one line and get no injected margin-top. -->
<div class="not-content grid gap-6">
  <section>
    <h3>React</h3>
    <ReactPlayer client:only="react" />
  </section>
  <section>
    <h3>Vue 3</h3>
    <VuePlayer client:only="vue" />
  </section>
</div>
